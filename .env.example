# SCALPER usa risorse proprie: non copiare DATABASE_URL da soldi-trend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/scalper?sslmode=require

# Fallback cron opzionale. Il motore principale usa MetaApi Streaming/WebSocket.
CRON_SECRET=change-me

# Password unica della dashboard. Senza questa variabile tutto risponde 503.
DASHBOARD_SECRET=change-me

METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=
METAAPI_SYMBOL_XAUUSD=XAUUSD

AUTO_EXEC=false
# Lotti di default; la dashboard puo' sovrascriverli scrivendo scalper_settings.exec_lots
EXEC_LOTS=0.05
SCALPER_LOTS_MIN=0.01
SCALPER_LOTS_MAX=0.10
MAX_DAILY_LOSS=150
# Trade per sessione: i doppioni (stesso setup e direzione entro TRADE_DEDUP_SECONDS) contano una volta sola.
MAX_TRADES_PER_DAY=20
TRADE_DEDUP_SECONDS=30
# Una sola posizione XAUUSD aperta alla volta.
SCALPER_MAX_OPEN_POSITIONS=1

SCALPER_MAX_SPREAD=1.20
SCALPER_MIN_ATR_M1=0.80
SCALPER_MAX_ATR_M1=6.00
# --- Dimensionamento SL/TP ---
# Distanza SL = max(struttura del setup, SL_ATR_MULT * ATR M1, SL_MIN_USD).
# Se il risultato supera SL_MAX_USD il trade viene scartato, mai stretto.
SL_ATR_MULT=1.3
SL_MIN_USD=3.0
SL_MAX_USD=8.0
# TP strutturale: massimo 2R e minimo 1.5R netto stimato.
MTF_TARGET_RR=2
MTF_MIN_NET_RR=1.5
# Cap di rischio per ordine in % del saldo: 0 = disattivato, i lotti restano quelli della dashboard
# e il rischio calcolato resta solo informativo su log, dashboard e Telegram.
RISK_MAX_PCT=0
RISK_FALLBACK_LOTS=0.01
SCALPER_LOSS_COOLDOWN_MIN=5
SCALPER_THREE_LOSS_COOLDOWN_MIN=30
# Pausa minima fra la chiusura di un trade e l'apertura successiva
SCALPER_MIN_REENTRY_SEC=120
SCALPER_HOURS_UTC=22:00-20:30
SCALPER_FLATTEN_BEFORE_END_MIN=5
SCALPER_FRIDAY_CLOSE_UTC=20:30
SCALPER_M1_CANDLES=500
SCALPER_M5_CANDLES=300

# --- Strategia M15 contesto / M5 setup / M1 conferma chiusa ---
MTF_M15_MIN_SEP_ATR=0.08
MTF_M15_MIN_EFFICIENCY=0.35
# Contesto M15: strict = solo trend M15 confermato; soft (default) = in transizione decide il bias M5,
# blocca solo il range vero (banda 12 M15 sotto M15_RANGE_BAND_ATR ATR con il prezzo dentro).
M15_TREND_MODE=soft
M15_RANGE_BAND_ATR=3.0
M15_RANGE_EDGE=0.15
M15_BIAS_M5_BARS=20
MTF_M5_SETUP_BARS=6
MTF_M5_ZONE_ATR=0.30
MTF_M1_BODY_MIN=0.45
MTF_MAX_CHASE_ATR=0.45
MTF_MAX_SPREAD_RISK=0.20
# Stime per il filtro, da calibrare sui costi reali del broker.
MTF_ROUNDTRIP_COMMISSION_PER_LOT_USD=7
MTF_SLIPPAGE_ATR=0.05
SHOCK_ATR_MULT=2.2
# Anti-duplicazione: stessa direzione bloccata per DUP_COOLDOWN_S, stesso setup per DUP_SETUP_BARS candele M1.
DUP_COOLDOWN_S=90
DUP_SETUP_BARS=3
# Dopo una chiusura in perdita: stessa direzione ferma per LOSS_LOCK_MINUTES.
LOSS_LOCK_MINUTES=30
# Dopo CONSEC_LOSS_COUNT perdite consecutive nella sessione: pausa totale.
CONSEC_LOSS_COUNT=3
CONSEC_LOSS_PAUSE_MINUTES=120
# Rilettura periodica delle chiusure per aggiornare i blocchi da perdita.
SCALPER_LOSS_LOCK_REFRESH_MS=30000
# Throttle del log per tick con i setup valutati (0 = ogni tick).
SCALPER_TICK_LOG_MS=1000

# Streaming/WebSocket worker
SCALPER_STREAM_POLL_MS=250
SCALPER_CONTROL_POLL_MS=1000
SCALPER_STREAM_SYNC_MS=1000
SCALPER_STREAM_HEARTBEAT_MS=5000
SCALPER_STREAM_QUOTE_PERSIST_MS=1000

# Notifiche Telegram (opzionali: senza queste due sendTelegram e' un no-op)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchdog (cron ogni 5 min: npm run watchdog)
WATCHDOG_MAX_AGE_SEC=180
WATCHDOG_CLOSE_AFTER_SEC=600

