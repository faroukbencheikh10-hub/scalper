# SCALPER usa risorse proprie: non copiare DATABASE_URL da soldi-trend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/scalper?sslmode=require

# Fallback cron opzionale. Il motore principale usa MetaApi Streaming/WebSocket.
CRON_SECRET=change-me

METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=
METAAPI_SYMBOL_XAUUSD=XAUUSD

AUTO_EXEC=false
EXEC_LOTS=0.05
MAX_DAILY_LOSS=150
MAX_TRADES_PER_DAY=12

SCALPER_MAX_SPREAD=1.20
SCALPER_MIN_ATR_M1=0.80
SCALPER_MAX_ATR_M1=6.00
SCALPER_MIN_RISK=2.00
SCALPER_MAX_RISK=5.00
SCALPER_RR=1.45
SCALPER_TIME_STOP_MIN=12
SCALPER_LOSS_COOLDOWN_MIN=5
SCALPER_THREE_LOSS_COOLDOWN_MIN=30
SCALPER_HOURS_UTC=06:30-20:30
SCALPER_M1_CANDLES=500
SCALPER_M5_CANDLES=300

# Streaming/WebSocket worker
SCALPER_STREAM_POLL_MS=250
SCALPER_CONTROL_POLL_MS=1000
SCALPER_STREAM_SYNC_MS=1000
SCALPER_STREAM_HEARTBEAT_MS=5000
SCALPER_STREAM_QUOTE_PERSIST_MS=1000
